# PostgreSQL — wymagane. Wygeneruj: openssl rand -hex 24
POSTGRES_PASSWORD=
# Dla uruchomienia bez Dockera użyj tego samego hasła w DATABASE_URL:
DATABASE_URL=postgresql://iw_user:POSTGRES_PASSWORD_HERE@localhost:55432/ironwarriors

# better-auth — wymagane w produkcji. Wygeneruj: openssl rand -base64 48
# Puste lub znane wartości (np. z tego pliku) są odrzucane przy NODE_ENV=production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Konto startowe administratora — potrzebne tylko przy pierwszym uruchomieniu.
# Skopiuj ten plik do `.env` obok docker-compose.yml (nie `.env.local`).
# Ustaw własne, losowe hasło (min. 12 znaków). Wartości przykładów są odrzucane.
# Bootstrap jest idempotentny: po utworzeniu konta możesz usunąć ADMIN_PASSWORD,
# a konto pozostanie w bazie. Kolejne konta: scripts/create-account.mjs (patrz README).
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Vercel Blob — opcjonalne.
# Bez tokenu uploady w panelu admina zapisują się lokalnie w public/uploads/
# (środowisko devskie działa więc w pełni bez konta Vercel).
# BLOB_READ_WRITE_TOKEN=

# Zmienne ustawiane automatycznie przez Vercel/v0 (nie wpisuj ręcznie):
# VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL, V0_RUNTIME_URL, V0_DEV_APP_URL,
# V0_BUILD_URL, V0_SANDBOX_URL

# Za reverse proxy (serwer uczelniany): zob. MAINTENANCE.md.
# Caddy domyślnie nadpisuje X-Forwarded-For adresem klienta, więc zwykle nic nie trzeba ustawiać.
# Gdy proxy DOPISUJE adres (nginx $proxy_add_x_forwarded_for), podaj jego adresy/CIDR:
# TRUSTED_PROXIES=172.16.0.0/12
# Albo wskaż nagłówek, który proxy ustawia samo, np. X-Real-IP:
# AUTH_IP_HEADER=x-real-ip
